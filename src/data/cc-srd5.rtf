\u8221\'94 and the }{{\field{\*\fldinst HYPERLINK "#section-ranger-spells" }{\fldrslt {\rtlch \ltrch\hich\af4\cf17\loch\f4\fs22\loch
ranger spell list}{}}}\loch
.}
