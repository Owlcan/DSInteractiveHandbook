\par \pard\plain \s63\dbch\af10\langfe1033\dbch\af9\afs24\alang1025\ql\widctlpar\hyphpar0\sb180\sa180\ltrpar\cf0\loch\f4\fs22\lang1033\kerning0{\loch{\*\bkmkstart eldritch-blast}{\*\bkmkend eldritch-blast}
