attunement}{}}}\rtlch\ai \ltrch\i\loch
)}
\par \pard\plain \s63\dbch\af10\langfe1033\dbch\af9\afs24\alang1025\ql\widctlpar\hyphpar0\sb180\sa180\ltrpar\cf0\loch\f4\fs22\lang1033\kerning0{\loch{\*\bkmkstart headband-of-intellect}{\*\bkmkend headband-of-intellect}
Your Intelligence score is 19 while you wear this headband. It has no effect on you if your Intelligence is already 19 or higher.}
\par \pard\plain \s3\dbch\af9\langfe1033\dbch\af9\afs24\alang1025\ab\ql\keep\widctlpar\hyphpar0\sb200\sa0\brdrb\brdrs\brdrw5\brdrcf31\brsp20\keepn\ltrpar\cf17\loch\f4\fs32\lang1033\b\kerning0{\loch
