{
	"name": "interactive-handbook",
	"version": "1.0.0",
	"private": true,
	"main": "main.js",
	"devDependencies": {
		"electron": "^31.6.0",
		"electron-builder": "^25.1.8",
		"tailwindcss": "^3.4.17"
	},
	"scripts": {
		"start": "electron .",
		"dev": "electron .",
		"build:tailwind": "tailwindcss -c ./tailwind.config.cjs -i ./styles/tailwind-input.css -o ./styles/tailwind.css --minify",
		"watch:tailwind": "tailwindcss -c ./tailwind.config.cjs -i ./styles/tailwind-input.css -o ./styles/tailwind.css --watch",
		"dist": "electron-builder"
	},
	"build": {
		"appId": "com.cellarways.app",
		"asar": true,
		"files": [
			"cellardungeon.html",
			"main.js",
			"preload.js",
			"Diaper-School-Full-Bestiary.json",
			"Monsters/**/*",
			"styles/**/*",
			"fonts/**/*",
			"package.json"
		],
		"win": {
			"target": ["nsis"]
		}
	}
}
