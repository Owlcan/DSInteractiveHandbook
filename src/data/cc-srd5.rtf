120,000}\cell\row\pard\trowd\trql\trleft-108\ltrrow\trpaddft3\trpaddt0\trpaddfl3\trpaddl0\trpaddfb3\trpaddb0\trpaddfr3\trpaddr0\clpadft3\clpadt108\clpadfr3\clpadr108\cellx1389\clpadft3\clpadt108\clpadfr3\clpadr108\cellx2512\pard\plain \s68\dbch\af10\langfe1033\dbch\af9\afs24\alang1025\ql\widctlpar\hyphpar0\sb36\sa36\ltrpar\cf0\loch\f4\fs22\lang1033\kerning0\intbl\qc\nowidctlpar\sb36\sa36{\rtlch \ltrch\i\loch
