\par \pard\plain \s68\dbch\af10\langfe1033\dbch\af9\afs24\alang1025\ql\widctlpar\hyphpar0\sb36\sa36\ltrpar\cf0\loch\f4\fs22\lang1033\kerning0{\listtext\pard\plain  \u8226\'95\tab}\ilvl0\ls171 \li720\ri0\lin720\rin0\fi-480{\loch
